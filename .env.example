# Local development: copy to backend/.env and use uv run --env-file .env ...
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/app.db
MAX_RAW_GB=10
MAX_PNG_GB=2
CORS_ORIGINS=http://localhost:5173
# Compose sets its own database URL (db is a Docker-only hostname):
# DATABASE_URL=postgresql+psycopg://orbit9:orbit9@db:5432/orbit9
